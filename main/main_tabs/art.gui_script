	UI.disable_list(TAB_NAME, tween_ui_list)

	local function get_range(i)
		local max_distance = math.huge
		if MEM.level_data.songLength then
			max_distance = tonumber(MEM.level_data.songLength) * 3
		end
		local spawn = G.clamp(instance_list[i].spawn_range * 16 - 7, 0, max_distance)
		local despawn = G.clamp(instance_list[i].despawn_range * 16 + 7, 0, max_distance)
		return G.round(spawn / 3, 1).."/"..G.round(despawn / 3, 1)
	end

	local instance_list_tab = {
		{
			type = hash("label"),
			node = gui.get_node("lbl_position_x"),
