function init(self)
	gui.set_render_order(1)
	msg.post("#", hash("disable"))
	UI.load_template({"sort", "button_replace", "button_rename", "button_find", "colour_guide", "import_models", "import_models_bulk",
	"button_materials", "button_transforms", "button_tweens", "button_instances"}, TAB_NAME)
	tab_buttons = {
		button_materials = gui.get_node("button_materials/button_white"),
		button_transforms = gui.get_node("button_transforms/button_white"),
		button_tweens = gui.get_node("button_tweens/button_white"),
		button_instances = gui.get_node("button_instances/button_white")
	}
	gui.set_color(tab_buttons[current_tab], SET.colour_active_text_field)
	gui.set_enabled(gui.get_node("transforms_background"), false)
	gui.set_enabled(gui.get_node("tweens_background"), false)
	gui.set_enabled(gui.get_node("instances_background"), false)
	transform_ui_list = TRANS.init(evaluate_button)
	UI.disable_list(TAB_NAME, transform_ui_list)
	
	local mat_template = gui.get_node("mat_0/button_white")
	local position = gui.get_position(mat_template)
	local start_y = position.y
	local size = gui.get_size(mat_template)
	local mat_background = gui.get_node("materials_background")
	for key, val in ipairs(material_list) do
		if key == 17 then
			position.x = position.x + size.x
			position.y = start_y
		end
		position.y = position.y - size.y
		if material_label_list[key] then
			local new_label = gui.clone(gui.get_node("mat_label_template"))
			gui.set_text(new_label, material_label_list[key])
			gui.set_position(new_label, position)
			gui.set_parent(new_label, mat_background, true)
			position.y = position.y - size.y
		end
		local new = gui.clone_tree(mat_template)
		gui.set_id(new["mat_0/button_white"], "mat_"..key.."/button_white")
		gui.set_id(new["mat_0/text"], "mat_"..key.."/text")
		gui.set_position(new["mat_0/button_white"], position)
		gui.set_text(new["mat_0/text"], string.sub(material_list[key], 20))
		gui.set_parent(new["mat_0/button_white"], mat_background, true)
		--gui.set_color(new["mat_0/button_white"], COL.materials[material_list[key]].tint())
		table.insert(material_buttons, new["mat_0/button_white"])
	end
	gui.delete_node(gui.get_node("mat_0/text"))
	gui.delete_node(mat_template)
	gui.delete_node(gui.get_node("mat_label_template"))

	local function get_tween_colour(tween_index)
		if tween_list[tween_index].collision then
			return SET.colour_tween_collision
		end
		local time = {S = 0, R = 0, T = 0}
		local count = {S = 0, R = 0, T = 0}
		for key, val in ipairs(tween_list[tween_index].script) do
			if time[val.type] then
				time[val.type] = time[val.type] + val.time
				count[val.type] = count[val.type] + 1
			end
		end
		if time.T > time.S and time.T > time.R then
			return SET.colour_tween_move
		elseif time.S > time.R and time.S > time.T then
			return SET.colour_tween_scale
		elseif time.R > time.S and time.R > time.T then
			return SET.colour_tween_rotate
		else
			if count.T > count.S and count.T > count.R then
				return SET.colour_tween_move
			elseif count.S > count.R and count.S > count.T then
				return SET.colour_tween_scale
			elseif count.R > count.S and count.R > count.T then
				return SET.colour_tween_rotate
			end
		end
		return vmath.vector4(1, 1, 1, 1)
	end

	local tween_list_tab = {
		{
			type = hash("exclusive_button"),
			node = gui.get_node("tween_exclusive/button_white"),
			text_node = gui.get_node("tween_exclusive/text"),
			value_fn = function(i)
				return tween_list[i].name.." ("..tween_list[i].signal..")"
			end,
			template = "tween_exclusive;",
			tint = get_tween_colour,
			release_only = true,
			fn = evaluate_button
		},
